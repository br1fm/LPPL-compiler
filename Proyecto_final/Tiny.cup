package constructorast;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import alex.TokenValue;
import errors.GestionErroresTiny;
import ast.*;
import java.util.LinkedList;

scan with {: return getScanner().next_token(); :};
//action code {:
//   ... add some code to declare and initialize e.g. variables used by the code embedded in the grammar
//:};
parser code {: 
   private GestionErroresTiny errores;
   public void syntax_error(Symbol unidadLexica) {
     errores.errorSintactico((UnidadLexica)unidadLexica);
   }
:};
init with {: 
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};


terminal IF, ELSE, TIPO_ENT, TRUE, FALSE, TIPO_BOOL, TIPO_HUGE, TIPO_REAL,
MAS, MENOS, IGUAL, IGUALIGUAL, DISTINTO, MAYOR, MENOR, MAYOR_IGUAL, MENOR_IGUAL, PAP, PCIERRE, CAP, 
CCIERRE, PUNTOCOMA, MULTIPLICA, DIVIDE, BUCLE_WHILE, WHILEIF;

terminal TokenValue IDEN, ENT, REAL, HUGE;
non terminal LinkedList<Instruccion> P, LInst, ElseCase;
non terminal Instruccion Inst, Cond, Asig, Decl, Bucle, BucleCond;
non terminal E E0, E1, E2, E3, E4;


P       ::= LInst: l
            {: RESULT = l; :};
            
LInst   ::= Inst: inst LInst: l
            {: l.addFirst(inst);
               RESULT = l;
            :}; 
LInst   ::=  
            {: RESULT = new LinkedList(); :};
            
Inst    ::= Cond: inst
            {: RESULT = inst; :}; 
Inst    ::= Asig: inst
            {: RESULT = inst; :};  
Inst    ::= Decl: inst
            {: RESULT = inst; :};  
Inst    ::= Bucle: inst
            {: RESULT = inst; :}; 
Inst    ::= BucleCond: inst
            {: RESULT = inst; :}; 

Asig    ::= IDEN: id IGUAL E0: exp PUNTOCOMA
            {: RESULT = new Asignacion(id.lexema, exp); :};
            
Decl    ::= TIPO_ENT IDEN: id PUNTOCOMA
            {: RESULT = new Declaracion(Type.NUM, id.lexema); :};
            
Decl    ::= TIPO_BOOL IDEN: id PUNTOCOMA
            {: RESULT = new Declaracion(Type.BOOL, id.lexema); :};

Decl    ::= TIPO_REAL IDEN: id PUNTOCOMA
            {: RESULT = new Declaracion(Type.REAL, id.lexema); :};
            
Decl    ::= TIPO_HUGE IDEN: id PUNTOCOMA
            {: RESULT = new Declaracion(Type.HUGE, id.lexema); :};

Decl    ::= TIPO_ENT IDEN:id CAP ENT:tam CCIERRE PUNTOCOMA
            {: RESULT = new DeclaracionArray(Type.NUM, id.lexema, tam.lexema); :};

Decl    ::= TIPO_BOOL IDEN:id CAP ENT:tam CCIERRE PUNTOCOMA
            {: RESULT = new DeclaracionArray(Type.BOOL, id.lexema, tam.lexema); :};

Decl    ::= TIPO_REAL IDEN:id CAP ENT:tam CCIERRE PUNTOCOMA
            {: RESULT = new DeclaracionArray(Type.REAL, id.lexema, tam.lexema); :};

Decl    ::= TIPO_HUGE IDEN:id CAP ENT:tam CCIERRE PUNTOCOMA
            {: RESULT = new DeclaracionArray(Type.HUGE, id.lexema, tam.lexema); :};

Cond    ::= IF PAP E0: exp PCIERRE CAP LInst: inst_if CCIERRE ElseCase: inst_else
            {: RESULT = new Condicional(exp, inst_if, inst_else); :};
ElseCase::= ELSE CAP LInst: l CCIERRE
            {: RESULT = l; :};
Bucle    ::= BUCLE_WHILE PAP E0:cond PCIERRE CAP LInst:cuerpo CCIERRE
            {: RESULT = new While(cond, cuerpo); :};         
BucleCond::= WHILEIF PAP E0:condBucle PUNTOCOMA E0:condIf PCIERRE CAP LInst:cuerpo CCIERRE ElseCase:cuerpoElse
            {: RESULT = new WhileIf(condBucle, condIf, cuerpo, cuerpoElse); :};

            
E0      ::= E0:op1 IGUALIGUAL E1:op2
            {: RESULT = new EBin(BinOps.IGUALIGUAL, op1, op2); :};
E0      ::= E0:op1 DISTINTO E1:op2
            {: RESULT = new EBin(BinOps.DISTINTO, op1, op2); :};
E0      ::= E1:exp
            {: RESULT = exp; :};

E1      ::= E1:op1 MAYOR E2:op2
            {: RESULT = new EBin(BinOps.MAYOR, op1, op2); :};
E1      ::= E1:op1 MENOR E2:op2
            {: RESULT = new EBin(BinOps.MENOR, op1, op2); :};
E1      ::= E1:op1 MAYOR_IGUAL E2:op2
            {: RESULT = new EBin(BinOps.MAYOR_IGUAL, op1, op2); :};
E1      ::= E1:op1 MENOR_IGUAL E2:op2
            {: RESULT = new EBin(BinOps.MENOR_IGUAL, op1, op2); :};
E1      ::= E2:exp
            {: RESULT = exp; :};

E2      ::= E2:op1 MAS E3:op2
            {: RESULT = new EBin(BinOps.MAS, op1, op2); :};
E2      ::= E2:op1 MENOS E3:op2
            {: RESULT = new EBin(BinOps.MENOS, op1, op2); :}; 
E2      ::= E3:exp
            {: RESULT = exp; :};

E3      ::= E3:op1 MULTIPLICA E4:op2
            {: RESULT = new EBin(BinOps.MULTIPLICA, op1, op2); :};
E3      ::= E3:op1 DIVIDE E4:op2
            {: RESULT = new EBin(BinOps.DIVIDE, op1, op2); :};
E3      ::= E4:exp
            {: RESULT = exp; :};

E4      ::= ENT: value
            {: RESULT = new Num(value.lexema); :}; 
E4      ::= HUGE: value
            {: RESULT = new Huge(value.lexema); :};        
E4      ::= REAL: value
            {: RESULT = new Real(value.lexema); :};
E4      ::= TRUE
            {: RESULT = new BoolValue("true"); :};
E4      ::= FALSE 
            {: RESULT = new BoolValue("false"); :};
E4      ::= IDEN: id
            {: RESULT = new Identificador(id.lexema); :}; 
E4      ::= PAP E0: exp PCIERRE
            {: RESULT = exp; :};



